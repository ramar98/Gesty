# =====================================================
# Gesty Backend - Variables de entorno
#
# Copiar a ".env" y completar los valores.
# El archivo .env NO se sube al repositorio.
# =====================================================

# ============================
# BASE DE DATOS
#
# En Railway se pueden usar las
# variables MYSQL* que provee el
# servicio (valen como fallback).
# ============================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Fallbacks Railway (opcionales si
# se usan DB_* de arriba)
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# ============================
# AUTENTICACIÓN
# ============================
# Secreto para firmar los JWT.
# Generar uno largo y aleatorio.
JWT_SECRET=

# ============================
# SERVIDOR
# ============================
PORT=
NODE_ENV=

# Orígenes permitidos por CORS
# (separados por coma, sin espacios)
# Ej: https://app.tudominio.com,http://localhost:5173
CORS_ORIGINS=

# Ruta del volumen de Railway para
# guardar las imágenes subidas
# (opcional, solo en producción)
RAILWAY_VOLUME_MOUNT_PATH=

# ============================
# SUSCRIPCIONES / MERCADO PAGO
# ============================

# Access token de Mercado Pago
# (Developers > Tus integraciones)
MP_ACCESS_TOKEN=

# Secreto del webhook para validar
# la firma HMAC de las notificaciones
# (Developers > Webhooks)
MP_WEBHOOK_SECRET=

# ID del usuario cobrador de MP
# y external_id de la caja/POS para
# el QR dinámico (se generan con
# node scripts/configurarQrMp.js)
MP_COLLECTOR_ID=
MP_POS_EXTERNAL_ID=

# URL pública de este backend
# (MP la usa para llamar al webhook)
API_PUBLIC_URL=

# URL del frontend
# (redirección después del pago)
FRONTEND_URL=

# Precio de la suscripción mensual
# en ARS (sin símbolo ni puntos)
PRECIO_SUSCRIPCION_MENSUAL=

# Días de prueba gratis al registrar
# una empresa (0 = paywall inmediato)
SUSCRIPCION_TRIAL_DIAS=
